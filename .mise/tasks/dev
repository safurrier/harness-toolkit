#!/usr/bin/env -S env UV_NO_CONFIG=1 uv run python
# MISE description="Start local development"
# MISE depends=["setup"]
import os
import shutil
import sys

sys.path.insert(0, os.path.join(os.environ["MISE_PROJECT_ROOT"], "scripts"))
from lib import (  # noqa: E402
    PROJECT_ROOT,
    dispatch_stack,
    get_modules,
    get_project_name,
    get_shape,
    log_error,
    log_step,
    log_warn,
    run,
)


def dev_python(cwd=PROJECT_ROOT):
    log_step("Starting Python development server")
    module_name = get_project_name().replace("-", "_")
    main_py = cwd / module_name / "__main__.py"
    if main_py.exists():
        run(["uv", "run", "python", "-m", module_name], cwd=cwd)
    else:
        log_warn("No __main__.py found — this appears to be a library.")
        log_warn(f"Add {module_name}/__main__.py for a runnable dev target.")


def dev_go(cwd=PROJECT_ROOT):
    log_step("Starting Go development server")
    run(["go", "run", "./cmd/..."], cwd=cwd)


def dev_rust(cwd=PROJECT_ROOT):
    log_step("Starting Rust development server")
    run(["cargo", "run"], cwd=cwd)


def dev_web(cwd=PROJECT_ROOT, extra_args: list[str] | None = None):
    log_step("Starting Web development server")
    run(["npm", "run", "dev", "--", *(extra_args or sys.argv[1:])], cwd=cwd)



def dev_blender(cwd=PROJECT_ROOT):
    blender = os.environ.get("BLENDER_BIN") or shutil.which("blender")
    if not blender:
        log_error("Blender not found. Install Blender, add it to PATH, or set BLENDER_BIN=/path/to/blender.")
        sys.exit(127)
    if (cwd / "scene.blend").exists():
        command = [blender, "scene.blend"]
    else:
        command = [blender, "--python", "scene.py"]
    log_step("Opening Blender scene")
    run(command, cwd=cwd)


def dev_threejs(cwd=PROJECT_ROOT, extra_args: list[str] | None = None):
    log_step("Starting Three.js development server")
    run(["npm", "run", "dev", "--", *(extra_args or sys.argv[1:])], cwd=cwd)


shape = get_shape()

if shape == "apps":
    if len(sys.argv) < 2:
        log_error("Apps workspace requires a module name: mise run dev -- <module>")
        log_step("Available modules:")
        for mod in get_modules():
            print(f"  {mod['name']} ({mod['kind']}, {mod['role']})")
        sys.exit(1)

    target = sys.argv[1]
    modules = {m["name"]: m for m in get_modules()}
    if target not in modules:
        log_error(f"Module '{target}' not found in workspace.toml")
        sys.exit(1)

    mod = modules[target]
    cwd = PROJECT_ROOT / mod["path"]
    log_step(f"[{target}] dev")
    fn = {"python": dev_python, "go": dev_go, "rust": dev_rust, "web": dev_web, "blender": dev_blender, "threejs": dev_threejs}.get(
        mod["kind"]
    )
    if fn:
        if mod["kind"] == "web":
            dev_web(cwd=cwd, extra_args=sys.argv[2:])
        else:
            fn(cwd=cwd)
    else:
        log_warn(f"{mod['kind']} stack: not yet implemented")
else:
    dispatch_stack(
        {"python": dev_python, "go": dev_go, "rust": dev_rust, "web": dev_web, "blender": dev_blender, "threejs": dev_threejs}
    )
