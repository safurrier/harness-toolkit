#!/usr/bin/env -S env UV_NO_CONFIG=1 uv run python
# MISE description="Build artifacts"
# MISE depends=["setup"]
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.join(os.environ["MISE_PROJECT_ROOT"], "scripts"))
from lib import (  # noqa: E402
    PROJECT_ROOT,
    dispatch_module,
    dispatch_stack,
    get_shape,
    log_ok,
    log_step,
    run,
    run_per_module,
)


def build_python(cwd=PROJECT_ROOT):
    log_step("Building Python package")
    run(["uv", "build"], cwd=cwd)
    log_ok("Python build")


def build_go(cwd=PROJECT_ROOT):
    log_step("Building Go binaries")
    (cwd / "bin").mkdir(exist_ok=True)
    result = subprocess.run(
        ["go", "build", "-o", "bin/", "./cmd/..."],
        cwd=cwd,
        env={**os.environ, "CGO_ENABLED": "0"},
    )
    if result.returncode != 0:
        sys.exit(result.returncode)
    log_ok("Go build")


def build_rust(cwd=PROJECT_ROOT):
    log_step("Building Rust binaries")
    run(["cargo", "build", "--release"], cwd=cwd)
    log_ok("Rust build")


def build_web(cwd=PROJECT_ROOT):
    log_step("Building Web app")
    run(["npm", "run", "build"], cwd=cwd)
    log_ok("Web build")



def _blender_bin():
    return os.environ.get("BLENDER_BIN") or shutil.which("blender")


def build_blender(cwd=PROJECT_ROOT):
    blender = _blender_bin()
    if not blender:
        raise RuntimeError("Blender not found. Install Blender, add it to PATH, or set BLENDER_BIN=/path/to/blender.")
    log_step("Rendering Blender scene")
    run([blender, "--background", "--python-exit-code", "1", "--python", "build.py"], cwd=cwd)
    log_ok("Blender scene render")


def build_threejs(cwd=PROJECT_ROOT):
    log_step("Building Three.js app")
    run(["npm", "run", "build"], cwd=cwd)
    log_ok("Three.js build")


if get_shape() == "apps":
    run_per_module(
        "build",
        dispatch_module(
            {"python": build_python, "go": build_go, "rust": build_rust, "web": build_web, "blender": build_blender, "threejs": build_threejs}
        ),
    )
else:
    dispatch_stack(
        {"python": build_python, "go": build_go, "rust": build_rust, "web": build_web, "blender": build_blender, "threejs": build_threejs}
    )
