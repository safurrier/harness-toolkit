#!/usr/bin/env -S uv run python
# MISE description="Check committed Harness Kit handoff exports when present"
from __future__ import annotations

import os
from pathlib import Path

from harness_toolkit.kit.local import (
    LocalWorkflowError,
    check_committed_handoff_exports,
)

root = Path(os.environ["MISE_PROJECT_ROOT"])
try:
    checked = check_committed_handoff_exports(root)
except LocalWorkflowError as exc:
    raise SystemExit(f"error: {exc}") from exc

if not checked:
    print("No committed HK exports to check.")
else:
    print(f"Validated {len(checked)} committed HK export package(s).")
