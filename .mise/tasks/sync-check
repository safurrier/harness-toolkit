#!/usr/bin/env -S uv run python
# MISE description="Check committed Harness Kit handoff exports when present"
from __future__ import annotations
import os, subprocess, sys
from pathlib import Path
root=Path(os.environ['MISE_PROJECT_ROOT'])
exports=root/'.ai'/'hk'
if not exports.exists():
    print('No committed HK exports to check.')
    raise SystemExit(0)
result=subprocess.run([str(root/'scripts'/'hk-dev'),'export','--format','handoff-dir','--check','--target','.'],cwd=root)
raise SystemExit(result.returncode)
