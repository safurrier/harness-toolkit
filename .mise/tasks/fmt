#!/usr/bin/env -S env UV_NO_CONFIG=1 uv run python
# MISE description="Format code"
# MISE depends=["setup"]
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, os.path.join(os.environ["MISE_PROJECT_ROOT"], "scripts"))
from lib import (  # noqa: E402
    PROJECT_ROOT,
    dispatch_module,
    dispatch_stack,
    get_shape,
    log_error,
    log_ok,
    log_step,
    run,
    run_per_module,
)

check = "--check" in sys.argv[1:]
SLICE_WORKFLOW_CLI_SRCS = (
    "templates/.agent/skills/slice-workflow/cli/src",
)


def python_format_paths(cwd: Path) -> list[str]:
    paths = ["."]
    for rel_path in SLICE_WORKFLOW_CLI_SRCS:
        if (cwd / rel_path).exists():
            paths.append(rel_path)
    return paths


def fmt_python(cwd=PROJECT_ROOT):
    log_step("Checking Python formatting" if check else "Formatting Python code")
    cmd = ["uv", "run", "ruff", "format"]
    if check:
        cmd.append("--check")
    cmd.extend(python_format_paths(cwd))
    run(cmd, cwd=cwd)
    log_ok("Python format")


def fmt_go(cwd=PROJECT_ROOT):
    if check:
        log_step("Checking Go formatting")
        result = subprocess.run(
            ["gofumpt", "-l", "."],
            capture_output=True,
            text=True,
            cwd=cwd,
        )
        if result.stdout.strip():
            log_error("Go files need formatting:")
            print(result.stdout)
            sys.exit(1)
    else:
        log_step("Formatting Go code")
        run(["gofumpt", "-w", "."], cwd=cwd)
    log_ok("Go format")


def fmt_rust(cwd=PROJECT_ROOT):
    if check:
        log_step("Checking Rust formatting")
        result = subprocess.run(
            ["cargo", "fmt", "--check"],
            capture_output=True,
            text=True,
            cwd=cwd,
        )
        if result.returncode != 0:
            log_error("Rust files need formatting:")
            print(result.stdout + result.stderr)
            sys.exit(1)
    else:
        log_step("Formatting Rust code")
        run(["cargo", "fmt"], cwd=cwd)
    log_ok("Rust format")


def fmt_web(cwd=PROJECT_ROOT):
    log_step("Checking Web formatting" if check else "Formatting Web code")
    run(["npm", "run", "fmt:check" if check else "fmt"], cwd=cwd)
    log_ok("Web format")



def fmt_blender(cwd=PROJECT_ROOT):
    log_step("Checking Blender scene formatting" if check else "Formatting Blender scene source")
    run(
        [
            "uv",
            "run",
            "ruff",
            "format",
            "--check" if check else "--force-exclude",
            "scene.py",
            "build.py",
            "tests",
        ],
        cwd=cwd,
    )
    log_ok("Blender format")


def fmt_threejs(cwd=PROJECT_ROOT):
    log_step("Checking Three.js formatting" if check else "Formatting Three.js source")
    run(["npm", "run", "fmt:check" if check else "fmt"], cwd=cwd)
    log_ok("Three.js format")


if get_shape() == "apps":
    run_per_module(
        "fmt",
        dispatch_module(
            {"python": fmt_python, "go": fmt_go, "rust": fmt_rust, "web": fmt_web, "blender": fmt_blender, "threejs": fmt_threejs}
        ),
    )
else:
    dispatch_stack(
        {"python": fmt_python, "go": fmt_go, "rust": fmt_rust, "web": fmt_web, "blender": fmt_blender, "threejs": fmt_threejs}
    )
