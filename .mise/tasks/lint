#!/usr/bin/env -S env UV_NO_CONFIG=1 uv run python
# MISE description="Run lint checks (non-modifying)"
# MISE depends=["setup"]
import os
import sys
from pathlib import Path

sys.path.insert(0, os.path.join(os.environ["MISE_PROJECT_ROOT"], "scripts"))
from lib import (  # noqa: E402
    PROJECT_ROOT,
    dispatch_module,
    dispatch_stack,
    get_shape,
    log_ok,
    log_step,
    run,
    run_per_module,
)

SLICE_WORKFLOW_CLI_SRCS = (
    "templates/.agent/skills/slice-workflow/cli/src",
)


def python_lint_paths(cwd: Path) -> list[str]:
    paths = ["."]
    for rel_path in SLICE_WORKFLOW_CLI_SRCS:
        if (cwd / rel_path).exists():
            paths.append(rel_path)
    return paths


def lint_python(cwd=PROJECT_ROOT):
    log_step("Linting Python code")
    run(["uv", "run", "ruff", "check", *python_lint_paths(cwd)], cwd=cwd)
    log_ok("Python lint")


def lint_go(cwd=PROJECT_ROOT):
    log_step("Linting Go code")
    run(["golangci-lint", "run", "./..."], cwd=cwd)
    log_ok("Go lint")


def lint_rust(cwd=PROJECT_ROOT):
    log_step("Linting Rust code")
    run(
        ["cargo", "clippy", "--all-targets", "--all-features", "--", "-D", "warnings"],
        cwd=cwd,
    )
    log_ok("Rust lint")


def lint_web(cwd=PROJECT_ROOT):
    log_step("Linting Web code")
    run(["npm", "run", "lint"], cwd=cwd)
    log_ok("Web lint")



def lint_blender(cwd=PROJECT_ROOT):
    log_step("Linting Blender scene source")
    run(["uv", "run", "ruff", "check", "scene.py", "build.py", "tests"], cwd=cwd)
    log_ok("Blender lint")


def lint_threejs(cwd=PROJECT_ROOT):
    log_step("Linting Three.js source")
    run(["npm", "run", "lint"], cwd=cwd)
    log_ok("Three.js lint")


if get_shape() == "apps":
    run_per_module(
        "lint",
        dispatch_module(
            {"python": lint_python, "go": lint_go, "rust": lint_rust, "web": lint_web, "blender": lint_blender, "threejs": lint_threejs}
        ),
    )
else:
    dispatch_stack(
        {"python": lint_python, "go": lint_go, "rust": lint_rust, "web": lint_web, "blender": lint_blender, "threejs": lint_threejs}
    )
