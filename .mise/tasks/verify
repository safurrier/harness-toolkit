#!/usr/bin/env -S env UV_NO_CONFIG=1 uv run python
# MISE description="Heavy validation gate (integration, docker, security, docs)"
# MISE depends=["setup"]
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.join(os.environ["MISE_PROJECT_ROOT"], "scripts"))
from lib import (  # noqa: E402
    PROJECT_ROOT,
    dispatch_module,
    dispatch_stack,
    get_project_name,
    get_shape,
    log_ok,
    log_step,
    run,
    run_per_module,
)

TASKS = PROJECT_ROOT / ".mise" / "tasks"


def _run_task(name: str, *args: str) -> None:
    r = subprocess.run([sys.executable, str(TASKS / name), *args])
    if r.returncode != 0:
        sys.exit(r.returncode)


def verify_python(cwd=PROJECT_ROOT):
    integration_dir = cwd / "tests" / "integration"
    if integration_dir.is_dir():
        log_step("Running Python integration tests")
        run(["uv", "run", "pytest", "tests/integration/", "-v"], cwd=cwd)
        log_ok("Integration tests")

    dockerfile = cwd / "Dockerfile"
    if dockerfile.exists():
        log_step("Building Docker image")
        run(["docker", "build", "-t", f"{get_project_name()}:verify", "."], cwd=cwd)
        log_ok("Docker build")


def verify_go(cwd=PROJECT_ROOT):
    tests_dir = cwd / "tests"
    if tests_dir.is_dir():
        log_step("Running Go integration tests")
        result = subprocess.run(
            ["go", "test", "-tags=integration", "./..."],
            cwd=cwd,
            env={**os.environ, "CGO_ENABLED": "0"},
        )
        if result.returncode != 0:
            sys.exit(result.returncode)
        log_ok("Integration tests")

    dockerfile = cwd / "Dockerfile"
    if dockerfile.exists():
        log_step("Building Docker image")
        run(["docker", "build", "-t", f"{get_project_name()}:verify", "."], cwd=cwd)
        log_ok("Docker build")


def verify_rust(cwd=PROJECT_ROOT):
    log_step("Running Rust integration tests")
    result = subprocess.run(
        ["cargo", "test", "--all-features"],
        cwd=cwd,
        capture_output=True,
        text=True,
    )
    print(result.stdout + result.stderr, end="")
    if result.returncode != 0:
        sys.exit(result.returncode)
    log_ok("Integration tests")

    dockerfile = cwd / "Dockerfile"
    if dockerfile.exists():
        log_step("Building Docker image")
        run(["docker", "build", "-t", f"{get_project_name()}:verify", "."], cwd=cwd)
        log_ok("Docker build")


def verify_web(cwd=PROJECT_ROOT):
    log_step("Building Web app for deploy")
    run(["npm", "run", "build"], cwd=cwd)
    log_ok("Web build")

    log_step("Running Wrangler deploy dry-run")
    run(["npm", "run", "deploy:dry-run"], cwd=cwd)
    log_ok("Wrangler deploy dry-run")



def verify_blender(cwd=PROJECT_ROOT):
    blender = os.environ.get("BLENDER_BIN") or shutil.which("blender")
    if not blender:
        raise RuntimeError("Blender not found. Install Blender, add it to PATH, or set BLENDER_BIN=/path/to/blender.")
    log_step("Rendering and reopening Blender scene")
    run(
        [
            blender,
            "--factory-startup",
            "--background",
            "--python-exit-code",
            "1",
            "--python",
            "build.py",
        ],
        cwd=cwd,
    )
    blend = cwd / "scene.blend"
    png = cwd / "scene.png"
    if not blend.is_file() or blend.stat().st_size == 0:
        raise RuntimeError("Blender build did not produce a nonempty scene.blend")
    if not png.is_file() or png.stat().st_size == 0:
        raise RuntimeError("Blender build did not produce a nonempty scene.png")
    if png.read_bytes()[:8] != b"\x89PNG\r\n\x1a\n":
        raise RuntimeError("Blender scene.png is not a PNG file")
    run(
        [
            blender,
            "--factory-startup",
            "--background",
            "scene.blend",
            "--python-exit-code",
            "1",
            "--python-expr",
            "import bpy; assert bpy.data.filepath.endswith('.blend')",
        ],
        cwd=cwd,
    )
    log_ok("Blender render and reopen")


def verify_threejs(cwd=PROJECT_ROOT):
    log_step("Building and browser-checking Three.js app")
    run(["npm", "run", "build"], cwd=cwd)
    run(["npm", "run", "e2e"], cwd=cwd)
    log_ok("Three.js browser verification")


log_step("Running verification suite")
log_step("Phase 1: quality gate (check)")
_run_task("check")

log_step("Phase 2: stack-specific verification")
if get_shape() == "apps":
    run_per_module(
        "verify",
        dispatch_module(
            {"python": verify_python, "go": verify_go, "rust": verify_rust, "web": verify_web, "blender": verify_blender, "threejs": verify_threejs}
        ),
    )
else:
    dispatch_stack(
        {"python": verify_python, "go": verify_go, "rust": verify_rust, "web": verify_web, "blender": verify_blender, "threejs": verify_threejs}
    )

log_ok("Verification complete")
