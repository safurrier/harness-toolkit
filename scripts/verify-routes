#!/usr/bin/env python3
"""Run required product verification routes selected by paths or a Git diff."""

from __future__ import annotations

import argparse
import fnmatch
import os
import subprocess
import tomllib
from pathlib import Path


def fail(message: str) -> None:
    raise SystemExit(f"error: {message}")


def paths_from_ref(root: Path, ref: str) -> list[str]:
    env = os.environ.copy()
    for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE"):
        env.pop(name, None)
    result = subprocess.run(
        ["git", "diff", "--name-only", "--no-renames", ref],
        cwd=root,
        env=env,
        text=True,
        capture_output=True,
    )
    if result.returncode:
        fail(f"cannot read changed paths for {ref}: {result.stderr.strip()}")
    return [path for path in result.stdout.splitlines() if path]


def matches(path: str, pattern: str) -> bool:
    return fnmatch.fnmatchcase(path, pattern) or fnmatch.fnmatchcase(
        path, f"**/{pattern}"
    )


def route_script(root: Path, route_id: str, configured_path: str) -> Path:
    """Return a route script only when it resolves inside scripts/verify."""
    relative_path = Path(configured_path)
    if relative_path.is_absolute():
        fail(f"route {route_id!r} script must be relative: {configured_path}")

    repository_root = root.resolve()
    scripts_dir = root / "scripts"
    configured_scripts_root = scripts_dir / "verify"
    if scripts_dir.is_symlink() or configured_scripts_root.is_symlink():
        fail("scripts/verify must be a repository-owned directory, not a symlink")
    scripts_root = configured_scripts_root.resolve()
    script = (root / relative_path).resolve()
    try:
        scripts_root.relative_to(repository_root)
        script.relative_to(scripts_root)
    except ValueError:
        fail(
            f"route {route_id!r} script must resolve beneath scripts/verify: "
            f"{configured_path}"
        )
    return script


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--path",
        action="append",
        default=[],
        help="Changed repo-relative path (repeatable)",
    )
    parser.add_argument(
        "--changed-from", help="Git diff range/ref used to select routes"
    )
    args = parser.parse_args()

    root = Path.cwd().resolve()
    config_parent = root / ".harness"
    config = config_parent / "verification.toml"
    if config_parent.is_symlink() or config.is_symlink():
        fail(".harness/verification.toml must be a repository-owned regular file")
    try:
        config.resolve().relative_to(root)
    except ValueError:
        fail(".harness/verification.toml must resolve inside the repository")
    if not config.is_file():
        fail(".harness/verification.toml is missing")

    try:
        data = tomllib.loads(config.read_text())
    except tomllib.TOMLDecodeError as exc:
        fail(f"malformed verification config: {exc}")
    if data.get("version") != 1 or not isinstance(data.get("routes", []), list):
        fail("verification config requires version = 1 and optional [[routes]] entries")

    has_selector = bool(args.path) or args.changed_from is not None
    changed_paths = args.path.copy()
    if args.changed_from is not None:
        changed_paths.extend(paths_from_ref(root, args.changed_from))
    selected_paths = list(dict.fromkeys(changed_paths))

    routes: list[dict[str, object]] = []
    ids: set[str] = set()
    for route in data.get("routes", []):
        if not isinstance(route, dict):
            fail("each route must be a table")
        route_id = route.get("id")
        script = route.get("script")
        patterns = route.get("paths", [])
        if not isinstance(route_id, str) or not route_id or route_id in ids:
            fail("route IDs must be unique non-empty strings")
        ids.add(route_id)
        if route.get("kind") == "manual":
            fail(f"manual route {route_id!r} cannot be an automated verification route")
        if (
            not isinstance(script, str)
            or not script
            or not isinstance(patterns, list)
            or not all(isinstance(pattern, str) and pattern for pattern in patterns)
        ):
            fail(f"route {route_id!r} requires script and paths")
        always = route.get("always") is True
        required = route.get("required", False)
        if always and patterns:
            fail(f"route {route_id!r} cannot combine always with paths")
        if required and not always and not patterns:
            fail(f"required route {route_id!r} needs paths or always = true")
        validated_script = route_script(root, route_id, script)
        if required:
            if (
                not validated_script.is_file()
                or not validated_script.stat().st_mode & 0o111
            ):
                fail(
                    f"route {route_id!r} script is missing or not executable: {script}"
                )
            routes.append(route)

    chosen = [
        route
        for route in routes
        if not has_selector
        or route.get("always") is True
        or any(
            matches(path, pattern)
            for path in selected_paths
            for pattern in route["paths"]  # type: ignore[union-attr]
        )
    ]
    if not chosen:
        print("No required verification routes selected.")
        return 0

    for route in chosen:
        route_id = route["id"]  # type: ignore[assignment]
        configured_path = route["script"]  # type: ignore[assignment]
        script = route_script(root, route_id, configured_path)
        if not script.is_file() or not script.stat().st_mode & 0o111:
            fail(
                f"route {route_id!r} script is missing or not executable: "
                f"{configured_path}"
            )
        print(f"==> Verification route: {route_id}")
        result = subprocess.run([str(script)], cwd=root)
        if result.returncode:
            return result.returncode

    print(f"Verified {len(chosen)} required route(s).")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
