#!/usr/bin/env python3
"""Run required product verification routes selected by paths or a Git diff."""
from __future__ import annotations
import argparse, fnmatch, subprocess, sys, tomllib
from pathlib import Path

def fail(message: str) -> None: raise SystemExit(f"error: {message}")
def paths_from_ref(root: Path, ref: str) -> list[str]:
    result=subprocess.run(["git","diff","--name-only",ref],cwd=root,text=True,capture_output=True)
    if result.returncode: fail(f"cannot read changed paths for {ref}: {result.stderr.strip()}")
    return [p for p in result.stdout.splitlines() if p]
def matches(path: str, pattern: str) -> bool:
    return fnmatch.fnmatchcase(path,pattern) or fnmatch.fnmatchcase(path, f"**/{pattern}")
def main() -> int:
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--path", action="append", default=[], help="Changed repo-relative path (repeatable)")
    parser.add_argument("--changed-from", help="Git diff range/ref used to select routes")
    args=parser.parse_args(); root=Path.cwd(); config=root/'.harness/verification.toml'
    if not config.is_file(): fail(".harness/verification.toml is missing")
    try: data=tomllib.loads(config.read_text())
    except tomllib.TOMLDecodeError as exc: fail(f"malformed verification config: {exc}")
    if data.get('version') != 1 or not isinstance(data.get('routes', []),list): fail("verification config requires version = 1 and optional [[routes]] entries")
    selected_paths=list(dict.fromkeys(args.path + (paths_from_ref(root,args.changed_from) if args.changed_from else [])))
    routes=[]; ids=set()
    for route in data.get('routes',[]):
        if not isinstance(route,dict): fail("each route must be a table")
        rid=route.get('id'); script=route.get('script'); patterns=route.get('paths',[])
        if not isinstance(rid,str) or not rid or rid in ids: fail("route IDs must be unique non-empty strings")
        ids.add(rid)
        if route.get('kind') == 'manual': fail(f"manual route {rid!r} cannot be an automated verification route")
        if not isinstance(script,str) or not script or not isinstance(patterns,list) or not all(isinstance(p,str) and p for p in patterns): fail(f"route {rid!r} requires script and paths")
        if route.get('always') is True and patterns: fail(f"route {rid!r} cannot combine always with paths")
        if route.get('required',False): routes.append(route)
    chosen=[r for r in routes if not selected_paths or r.get('always') is True or any(matches(p,glob) for p in selected_paths for glob in r['paths'])]
    if not chosen:
        print('No required verification routes selected.'); return 0
    for route in chosen:
        script=root/route['script']
        if not script.is_file() or not script.stat().st_mode & 0o111: fail(f"route {route['id']!r} script is missing or not executable: {route['script']}")
        print(f"==> Verification route: {route['id']}")
        result=subprocess.run([str(script)],cwd=root)
        if result.returncode: return result.returncode
    print(f"Verified {len(chosen)} required route(s).")
    return 0
if __name__ == '__main__': raise SystemExit(main())
